---
import { getCollection } from "astro:content";
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import ProjectCard from "./ProjectCard.astro";

const [{ data }] = await getCollection("projects");
const markdown = await createMarkdownProcessor();

const projects = await Promise.all(
  data.projects.map(async (project) => ({
    ...project,
    description: (await markdown.render(project.description)).code,
  })),
);
---

<div class="max-w-3xl mx-auto">
  <h1 class="page-header text-3xl md:text-4xl mb-8">Projects</h1>

  {
    projects.map((project) => (
      <ProjectCard
        title={project.title}
        subtitle={project.subtitle}
        link={project.link}
        iconName={project.iconName}
        iconSize={project.iconSize}
        techList={project.tech}
      >
        <div slot="description" class="project-desc" set:html={project.description} />
      </ProjectCard>
    ))
  }
</div>

<style>
  .project-desc :global(a) {
    color: var(--color-link);
    text-decoration: none;
  }
  .project-desc :global(a:hover) {
    color: var(--color-accent);
    text-decoration: underline;
  }
  .dark .project-desc :global(a) {
    color: var(--color-link-dark);
  }
  .dark .project-desc :global(a:hover) {
    color: var(--color-accent-dark);
  }
</style>